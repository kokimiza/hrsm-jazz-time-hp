# Sanityプロジェクトの情報（studio/sanity.cli.ts の projectId と揃える）
# 未設定でも `pnpm build` / `pnpm dev` は通る（CMSコンテンツが空の状態でビルドされる）
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Sanity API version。日付形式（YYYY-MM-DD）。詳細: https://www.sanity.io/docs/apis-and-sdks/api-versioning
PUBLIC_SANITY_API_VERSION=2026-08-28
