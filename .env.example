# Sanityプロジェクトの情報（studio/.env の SANITY_STUDIO_PROJECT_ID と同じ値を入れる。変数名が違うので注意）
# 未設定でも `pnpm build` / `pnpm dev` は通る（CMSコンテンツが空の状態でビルドされる）
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Sanity API version。日付形式（YYYY-MM-DD）。詳細: https://www.sanity.io/docs/apis-and-sdks/api-versioning
PUBLIC_SANITY_API_VERSION=2026-08-28

# サイトの絶対オリジン（末尾スラッシュなし）。sitemap.xml / robots.txt の絶対URL生成に使う。
# 仮ドメイン運用中はCloudflare Pagesプロジェクトの https://<project>.pages.dev を、
# 本ドメイン確定後はそちらを設定する。未設定でもビルドは通る（プレースホルダーにfallbackする）。
PUBLIC_SITE_URL=https://hiroshima-jazztime.pages.dev
